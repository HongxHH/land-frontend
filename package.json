{
  "name": "front",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --environment jsdom",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{js,vue,ts,css,scss}\" \"*.{js,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,ts,css,scss}\" \"*.{js,mjs}\"",
    "metrics:src": "node scripts/src-metrics.mjs",
    "orphan:src": "node scripts/find-orphan-modules.mjs",
    "check:exceljs-lazy": "node scripts/check-exceljs-import.mjs",
    "verify": "npm run build && npm run test && npm run lint && npm run check:exceljs-lazy"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@stomp/stompjs": "^7.3.0",
    "@vue-office/excel": "^1.7.14",
    "axios": "^1.13.2",
    "buffer": "^6.0.3",
    "dayjs": "^1.11.20",
    "dompurify": "^3.4.5",
    "element-plus": "^2.13.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "marked": "^17.0.1",
    "sass": "^1.97.2",
    "sockjs-client": "^1.6.1",
    "vue": "^3.5.26",
    "vue-demi": "^0.14.10",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.6.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.8.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0",
    "vue-eslint-parser": "^10.4.0"
  }
}
